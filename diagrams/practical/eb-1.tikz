\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=small box] (2) at (-1.5, 1) {$q$};
		\node [style=small box] (3) at (-5, -0.75) {$p$};
		\node [style=none] (6) at (1.25, -0.25) {};
		\node [style=none] (7) at (1.25, -0.75) {};
		\node [style=none] (11) at (0.5, 1) {$\tau_i$};
		\node [style=none] (12) at (-3.75, -0.25) {$\vartheta$};
		\node [style=none] (15) at (-2.75, 2.25) {};
		\node [style=none] (16) at (-2.75, -1.75) {};
		\node [style=none] (17) at (3, -1.75) {};
		\node [style=none] (18) at (3, 2.25) {};
		\node [style=none] (19) at (1.75, -2.25) {$i = 1:N$};
		\node [style=none] (20) at (-0.5, 1) {};
		\node [style=small box] (22) at (1.5, -0.5) {$f$};
