\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-1.5, 0) {};
		\node [style=black node] (1) at (0, 0) {};
		\node [style=none] (2) at (1, 1.25) {};
		\node [style=none] (3) at (1, -1.25) {};
		\node [style=none] (4) at (1.5, 1.25) {};
		\node [style=none] (5) at (1.5, -1.25) {};
		\node [style=none] (6) at (1, 0.15) {$\vdots$};
		\node [style=none] (7) at (1, -0.75) {};
		\node [style=none] (8) at (1.5, -0.75) {};
		\node [style=none] (9) at (1, 0.75) {};
		\node [style=none] (10) at (1.5, 0.75) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=edge] (0.center) to (1);
		\draw [style=edge, in=-180, out=90] (1) to (2.center);
		\draw [style=edge] (2.center) to (4.center);
		\draw [style=edge, in=180, out=-90] (1) to (3.center);
		\draw [style=edge] (3.center) to (5.center);
		\draw [style=edge] (7.center) to (8.center);
		\draw [style=edge] (9.center) to (10.center);
		\draw [style=edge, in=60, out=-180] (9.center) to (1);
		\draw [style=edge, in=180, out=-60] (1) to (7.center);
	\end{pgfonlayer}
\end{tikzpicture}
