\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-1.25, 0.75) {};
		\node [style=none] (1) at (-0.75, 0.75) {};
		\node [style=none] (2) at (0.75, -0.75) {};
		\node [style=none] (3) at (1.25, -0.75) {};
		\node [style=none] (4) at (1.25, 0.75) {};
		\node [style=none] (5) at (0.75, 0.75) {};
		\node [style=none] (6) at (-0.75, -0.75) {};
		\node [style=none] (7) at (-1.25, -0.75) {};
		\node [style=none] (8) at (-1, 1.25) {$X$};
		\node [style=none] (9) at (1, 1.25) {$Y$};
		\node [style=none] (10) at (-1, -0.25) {$Y$};
		\node [style=none] (11) at (1, -0.25) {$X$};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=edge] (0.center) to (1.center);
		\draw [style=edge] (2.center) to (3.center);
		\draw [style=edge, in=-180, out=0, looseness=1.25] (1.center) to (2.center);
		\draw [style=edge] (4.center) to (5.center);
		\draw [style=edge] (6.center) to (7.center);
		\draw [style=edge, in=0, out=180, looseness=1.25] (5.center) to (6.center);
	\end{pgfonlayer}
\end{tikzpicture}
