\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-5, 0) {};
		\node [style=black node] (1) at (-3.5, 0) {};
		\node [style=none] (2) at (-2.5, 0.75) {};
		\node [style=none] (3) at (-2.5, -0.75) {};
		\node [style=none] (4) at (-2, 0.75) {};
