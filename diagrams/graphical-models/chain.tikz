\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-3.5, 0) {};
		\node [style=small box] (1) at (-2, 0) {$f$};
		\node [style=small box] (2) at (0, 0) {$g$};
		\node [style=small box] (3) at (2, 0) {$h$};
