	\begin{pgfonlayer}{edgelayer}
		\draw [style=edge] (0) to (1);
		\draw [style=edge, in=180, out=90, looseness=0.75] (1) to (2);
		\draw [style=edge, in=180, out=60] (1) to (3);
		\draw [style=edge, in=180, out=-60] (1) to (4);
		\draw [style=edge, in=-180, out=-90, looseness=0.75] (1) to (5);
		\draw [style=edge] (2) to (6.center);
		\draw [style=edge] (3) to (7.center);
		\draw [style=edge] (4) to (8.center);
		\draw [style=edge] (5) to (9.center);
		\draw [style=edge] (1) to (10.center);
